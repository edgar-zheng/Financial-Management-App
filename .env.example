MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MARKET_API_KEY=
FRONTEND_PORT=

# Spring Boot / Elastic Beanstalk (placeholders only; do not overwrite an existing .env).
# MARKET_API_KEY above supplies the Spring property market.api.key.
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:mysql://<AIVEN_HOST>:<AIVEN_PORT>/<DATABASE_NAME>?sslMode=REQUIRED
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
FRONTEND_URL=http://localhost:5173
# EB proxy and application must agree on this port. Omit locally for port 8080.
PORT=5000
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax
