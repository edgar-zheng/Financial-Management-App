MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MARKET_API_KEY=
FRONTEND_PORT=

# Spring Boot / Elastic Beanstalk (placeholders only; do not overwrite an existing .env).
# MARKET_API_KEY above supplies the Spring property market.api.key.
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:mysql://<AIVEN_HOST>:<AIVEN_PORT>/<DATABASE_NAME>?sslMode=VERIFY_IDENTITY
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
AIVEN_TRUSTSTORE_PATH=/absolute/path/to/aiven-truststore.jks
AIVEN_TRUSTSTORE_PASSWORD=
FRONTEND_URL=http://localhost:5173
# EB proxy and application must agree on this port. Omit locally for port 8080.
PORT=5000
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=none

# Browser-visible backend origin; never put secrets in VITE_ variables.
# Local example: http://localhost:8080
VITE_API_BASE_URL=https://<distribution>.cloudfront.net
