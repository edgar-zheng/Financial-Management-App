server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    # Docker DNS: refresh upstream addresses after backend container recreation.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # BACKEND_URL is a required runtime origin, without a trailing slash/path.
    # Preserve the original /api path and query string when resolving dynamically.
    location ~ ^/api(?:/|$) {
        set $backend_origin ${BACKEND_URL};
        proxy_pass $backend_origin$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /assets/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
